    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.12" />
    <PackageReference Include="MimeKit" Version="4.16.0" />
    <PackageReference Include="Polly" Version="8.4.0" />
    <PackageReference Include="Scriban" Version="7.2.5" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EmailAutomation.Application\EmailAutomation.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EmailAutomation.Tests" />
  </ItemGroup>

</Project>
