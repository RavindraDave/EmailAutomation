<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:EmailAutomation.UI.ViewModels"
             x:Class="EmailAutomation.UI.Views.BatchExecutionView"
             x:DataType="vm:BatchExecutionViewModel">
  <StackPanel Margin="20">
    <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

    <TextBlock Text="Excel File:" Margin="0,0,0,5" />
    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,20">
      <TextBox Grid.Column="0" Text="{Binding ExcelFilePath}" />
      <Button Grid.Column="1" Content="Browse..." Margin="10,0,0,0" />
    </Grid>

    <TextBlock Text="Template Selection:" Margin="0,0,0,5"/>
    <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" Margin="0,0,0,20" HorizontalAlignment="Stretch">
      <ComboBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>

    <ProgressBar Value="{Binding ProgressValue}" Height="20" Margin="0,0,0,20" />

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Start" IsEnabled="{Binding !IsRunning}" Command="{Binding StartBatchCommand}" />
      <Button Content="Pause" IsEnabled="{Binding IsRunning}" Command="{Binding PauseBatch}" />
      <Button Content="Resume" IsEnabled="{Binding !IsRunning}" Command="{Binding ResumeBatch}" />
      <Button Content="Stop" IsEnabled="{Binding IsRunning}" Command="{Binding StopBatch}" />
    </StackPanel>
  </StackPanel>
</UserControl>
